# Controls what `gcloud builds submit` uploads as the build context.
# IMPORTANT: without this file, gcloud falls back to .gitignore, which excludes
# *.db — that would drop the committed analytics DB the web image bakes in.
# data/gridiron.db is intentionally NOT excluded here.

.git/
.github/
.venv/
venv/
__pycache__/
**/__pycache__/
*.pyc
*.egg-info/
.pytest_cache/
.ruff_cache/

# Secrets / local env
.env
.env.*

# Node — rebuilt inside the image
node_modules/
frontend/node_modules/
frontend/dist/
frontend/build/

# Lakehouse / orchestration local state — not needed by the web service
.dagster_home/
.tmp_dagster_home_*/
warehouse/target/
warehouse/dbt_packages/
warehouse/logs/
data/raw/
data/processed/
data/lakehouse/
data/warehouse.duckdb
*.duckdb

# Misc — not needed by the web build
reports/
notebooks/
tableau/
tests/
docs/
.DS_Store
.idea/
.vscode/
